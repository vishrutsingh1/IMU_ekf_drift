<launch>
  <!-- Zero-velocity pose hold for robot_localization -->
  <node pkg="imu_fusion" type="imu_fusion.py" name="imu_filter" output="screen">
    <param name="timer"              value="5.0"/>   <!-- seconds still before latching pose -->
    <param name="pose_correct_timer" value="10.0"/>  <!-- seconds between resets while still -->
    <param name="set_pose_service"   value="/set_pose"/>
  </node>
</launch>
